<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsagePill</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UsagePill</AssemblyName>
    <Product>Usage Pill</Product>
    <Description>An always-on-top pill showing Claude usage limits as ring gauges.</Description>
    <!-- Overridden by the release workflow with -p:Version from the git tag. -->
    <Version>0.2.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is enabled only for the tray icon. Its implicit usings shadow the WPF
         types this app is built on (Application, Color, Brush, Point), so WinForms is
         referenced explicitly where it is needed instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
